[Unit]
Description=Saldo consistent database backup
After=saldo.service

[Service]
Type=oneshot
User=saldo
Group=saldo
ExecStart=/usr/bin/python3 /opt/saldo/current/deploy/backup.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/saldo /var/backups/saldo
